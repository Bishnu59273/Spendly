generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(dbgenerated("concat('u_', (gen_random_uuid())::text)"))
  email         String         @unique
  password      String
  name          String
  salaryDay     Int            @default(1) @map("salary_day")
  currency      String         @default("INR")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  monthlyBudget Float?         @map("monthly_budget")
  useDefaultBudget Boolean     @default(true) @map("use_default_budget")
  upiId         String?        @map("upi_id")
  tokenVersion  Int            @default(0) @map("token_version")
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil   DateTime?      @map("locked_until") @db.Timestamptz(6)
  tourCompleted Boolean        @default(false) @map("tour_completed")
  feedbackRemindAt DateTime?   @map("feedback_remind_at") @db.Timestamptz(6)
  pushPromptRemindAt DateTime? @map("push_prompt_remind_at") @db.Timestamptz(6)
  savingsBannerDismissedMonth String? @map("savings_banner_dismissed_month")
  budgets       Budget[]
  monthlyBudgets MonthlyBudget[]
  categories    Category[]
  expenses      Expense[]
  feedback      Feedback[]
  goals         Goal[]
  tags          Tag[]
  incomeSources IncomeSource[]
  resetTokens   PasswordResetToken[]
  announcementRead AnnouncementRead?
  pushSubscriptions PushSubscription[]
  groupsCreated        Group[]              @relation("GroupCreatedBy")
  groupMemberships     GroupMember[]
  groupExpensesPaid    GroupExpense[]       @relation("GroupExpensePaidBy")
  groupExpensesCreated GroupExpense[]       @relation("GroupExpenseCreatedBy")
  groupExpenseSplits   GroupExpenseSplit[]
  settlementsFrom      Settlement[]         @relation("SettlementFrom")
  settlementsTo        Settlement[]         @relation("SettlementTo")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("concat('prt_', (gen_random_uuid())::text)"))
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_password_reset_tokens_user")
  @@map("password_reset_tokens")
}

model Category {
  id               String    @id @default(dbgenerated("concat('cat_', (gen_random_uuid())::text)"))
  name             String
  color            String
  icon             String
  budgetLimit      Float?    @map("budget_limit")
  isDefault        Boolean   @default(false) @map("is_default")
  isSystemManaged  Boolean   @default(false) @map("is_system_managed")
  userId           String    @map("user_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientMutationId String?   @map("client_mutation_id")
  budgets          Budget[]
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenses         Expense[]

  @@index([userId], map: "idx_categories_user")
  @@index([userId, clientMutationId], map: "idx_categories_user_client_mutation")
  @@map("categories")
}

model Tag {
  id               String       @id @default(dbgenerated("concat('tag_', (gen_random_uuid())::text)"))
  name             String
  color            String
  icon             String
  userId           String       @map("user_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientMutationId String?      @map("client_mutation_id")
  expenses         ExpenseTag[]
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_tags_user")
  @@index([userId, clientMutationId], map: "idx_tags_user_client_mutation")
  @@map("tags")
}

model Expense {
  id               String        @id @default(dbgenerated("concat('exp_', (gen_random_uuid())::text)"))
  amount           Float
  type             String        @default("EXPENSE")
  note             String?
  date             DateTime      @db.Timestamptz(6)
  isRecurring      Boolean       @default(false) @map("is_recurring")
  recurringDay     Int?          @map("recurring_day")
  categoryId       String?       @map("category_id")
  sourceId         String?       @map("source_id")
  goalId           String?       @map("goal_id")
  groupExpenseId   String?       @unique @map("group_expense_id")
  userId           String        @map("user_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientMutationId String?       @map("client_mutation_id")
  tags             ExpenseTag[]
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source           IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  goal             Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  groupExpense     GroupExpense? @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, date], map: "idx_expenses_user_date")
  @@index([userId, clientMutationId], map: "idx_expenses_user_client_mutation")
  @@map("expenses")
}

model IncomeSource {
  id               String    @id @default(dbgenerated("concat('src_', (gen_random_uuid())::text)"))
  name             String
  icon             String    @default("💰")
  isDefault        Boolean   @default(false) @map("is_default")
  userId           String    @map("user_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientMutationId String?   @map("client_mutation_id")
  expenses         Expense[]
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_income_sources_user")
  @@index([userId, clientMutationId], map: "idx_income_sources_user_client_mutation")
  @@map("income_sources")
}

model ExpenseTag {
  expenseId String  @map("expense_id")
  tagId     String  @map("tag_id")
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([expenseId, tagId])
  @@map("expense_tags")
}

model Budget {
  id         String   @id @default(dbgenerated("concat('bud_', (gen_random_uuid())::text)"))
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  month      Int
  year       Int
  cap        Float
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year], map: "idx_budgets_user")
  @@map("budgets")
}

model MonthlyBudget {
  id        String   @id @default(dbgenerated("concat('mbud_', (gen_random_uuid())::text)"))
  userId    String   @map("user_id")
  month     Int
  year      Int
  amount    Float
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, month, year])
  @@index([userId, month, year], map: "idx_monthly_budgets_user")
  @@map("monthly_budgets")
}

model Goal {
  id               String         @id @default(dbgenerated("concat('goal_', (gen_random_uuid())::text)"))
  userId           String         @map("user_id")
  name             String
  icon             String         @default("🎯")
  color            String         @default("#1d6b51")
  target           Float
  saved            Float          @default(0)
  monthly          Float          @default(0)
  isPrimary        Boolean        @default(false) @map("is_primary")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientMutationId String?        @map("client_mutation_id")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  snapshots        GoalSnapshot[]
  expenses         Expense[]

  @@index([userId], map: "idx_goals_user")
  @@index([userId, clientMutationId], map: "idx_goals_user_client_mutation")
  @@map("goals")
}

model Feedback {
  id             String   @id @default(dbgenerated("concat('fb_', (gen_random_uuid())::text)"))
  userId         String   @map("user_id")
  stars          Int
  recommendation String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_feedback_user")
  @@map("feedback")
}

model Announcement {
  id        String   @id @default(dbgenerated("concat('ann_', (gen_random_uuid())::text)"))
  title     String
  body      String
  icon      String   @default("🔔")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("announcements")
}

model AnnouncementRead {
  id         String   @id @default(dbgenerated("concat('anr_', (gen_random_uuid())::text)"))
  userId     String   @unique @map("user_id")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("announcement_reads")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("concat('psub_', (gen_random_uuid())::text)"))
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_push_subscriptions_user")
  @@map("push_subscriptions")
}

model GoalSnapshot {
  id           String   @id @default(dbgenerated("concat('gsnap_', (gen_random_uuid())::text)"))
  goalId       String   @map("goal_id")
  savedAmount  Float    @map("saved_amount")
  snapshotDate DateTime @default(now()) @map("snapshot_date") @db.Timestamptz(6)
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, snapshotDate], map: "idx_goal_snapshots_goal_date")
  @@map("goal_snapshots")
}

model Group {
  id          String         @id @default(dbgenerated("concat('grp_', (gen_random_uuid())::text)"))
  name        String
  icon        String         @default("🏠")
  color       String         @default("#1d6b51")
  inviteCode  String         @unique @map("invite_code")
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   User           @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members     GroupMember[]
  expenses    GroupExpense[]
  settlements Settlement[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(dbgenerated("concat('gmem_', (gen_random_uuid())::text)"))
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  isOwner  Boolean  @default(false) @map("is_owner")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, userId])
  @@index([userId], map: "idx_group_members_user")
  @@map("group_members")
}

model GroupExpense {
  id          String              @id @default(dbgenerated("concat('gexp_', (gen_random_uuid())::text)"))
  groupId     String              @map("group_id")
  description String
  amount      Float
  splitType   String              @map("split_type")
  paidById    String              @map("paid_by_id")
  createdById String              @map("created_by_id")
  date        DateTime            @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  paidBy      User                @relation("GroupExpensePaidBy", fields: [paidById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User                @relation("GroupExpenseCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  splits      GroupExpenseSplit[]
  personalExpense Expense?

  @@index([groupId, date], map: "idx_group_expenses_group_date")
  @@map("group_expenses")
}

model GroupExpenseSplit {
  id             String       @id @default(dbgenerated("concat('gspl_', (gen_random_uuid())::text)"))
  groupExpenseId String       @map("group_expense_id")
  userId         String       @map("user_id")
  shareAmount    Float        @map("share_amount")
  sharePercent   Float?       @map("share_percent")
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupExpenseId, userId])
  @@map("group_expense_splits")
}

model Settlement {
  id            String    @id @default(dbgenerated("concat('gset_', (gen_random_uuid())::text)"))
  groupId       String    @map("group_id")
  fromUserId    String    @map("from_user_id")
  toUserId      String    @map("to_user_id")
  amount        Float
  status        String    @default("PENDING")
  initiatedById String    @map("initiated_by_id")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromUser      User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toUser        User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([groupId, status], map: "idx_settlements_group_status")
  @@map("settlements")
}
