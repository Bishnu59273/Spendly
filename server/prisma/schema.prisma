generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(dbgenerated("concat('u_', (gen_random_uuid())::text)"))
  email         String         @unique
  password      String
  name          String
  salaryDay     Int            @default(1) @map("salary_day")
  currency      String         @default("INR")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  monthlyBudget Float?         @map("monthly_budget")
  budgets       Budget[]
  categories    Category[]
  expenses      Expense[]
  feedback      Feedback[]
  goals         Goal[]
  tags          Tag[]
  incomeSources IncomeSource[]

  @@map("users")
}

model Category {
  id          String    @id @default(dbgenerated("concat('cat_', (gen_random_uuid())::text)"))
  name        String
  color       String
  icon        String
  budgetLimit Float?    @map("budget_limit")
  isDefault   Boolean   @default(false) @map("is_default")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  budgets     Budget[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenses    Expense[]

  @@index([userId], map: "idx_categories_user")
  @@map("categories")
}

model Tag {
  id        String       @id @default(dbgenerated("concat('tag_', (gen_random_uuid())::text)"))
  name      String
  color     String
  icon      String
  userId    String       @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expenses  ExpenseTag[]
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_tags_user")
  @@map("tags")
}

model Expense {
  id           String        @id @default(dbgenerated("concat('exp_', (gen_random_uuid())::text)"))
  amount       Float
  type         String        @default("EXPENSE")
  note         String?
  date         DateTime      @db.Timestamptz(6)
  isRecurring  Boolean       @default(false) @map("is_recurring")
  recurringDay Int?          @map("recurring_day")
  categoryId   String?       @map("category_id")
  sourceId     String?       @map("source_id")
  userId       String        @map("user_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tags         ExpenseTag[]
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source       IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, date], map: "idx_expenses_user_date")
  @@map("expenses")
}

model IncomeSource {
  id        String    @id @default(dbgenerated("concat('src_', (gen_random_uuid())::text)"))
  name      String
  icon      String    @default("💰")
  isDefault Boolean   @default(false) @map("is_default")
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expenses  Expense[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_income_sources_user")
  @@map("income_sources")
}

model ExpenseTag {
  expenseId String  @map("expense_id")
  tagId     String  @map("tag_id")
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([expenseId, tagId])
  @@map("expense_tags")
}

model Budget {
  id         String   @id @default(dbgenerated("concat('bud_', (gen_random_uuid())::text)"))
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  month      Int
  year       Int
  cap        Float
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year], map: "idx_budgets_user")
  @@map("budgets")
}

model Goal {
  id        String         @id @default(dbgenerated("concat('goal_', (gen_random_uuid())::text)"))
  userId    String         @map("user_id")
  name      String
  icon      String         @default("🎯")
  color     String         @default("#1d6b51")
  target    Float
  saved     Float          @default(0)
  monthly   Float          @default(0)
  isPrimary Boolean        @default(false) @map("is_primary")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  snapshots GoalSnapshot[]

  @@index([userId], map: "idx_goals_user")
  @@map("goals")
}

model Feedback {
  id             String   @id @default(dbgenerated("concat('fb_', (gen_random_uuid())::text)"))
  userId         String   @map("user_id")
  stars          Int
  recommendation String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_feedback_user")
  @@map("feedback")
}

model GoalSnapshot {
  id           String   @id @default(dbgenerated("concat('gsnap_', (gen_random_uuid())::text)"))
  goalId       String   @map("goal_id")
  savedAmount  Float    @map("saved_amount")
  snapshotDate DateTime @default(now()) @map("snapshot_date") @db.Timestamptz(6)
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, snapshotDate], map: "idx_goal_snapshots_goal_date")
  @@map("goal_snapshots")
}
